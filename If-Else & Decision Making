13.Find Profit or Loss :
#include <stdio.h>
int main() {
    float cost,selling;
    printf("Enter cost price and selling price: ");
    scanf("%f%f",&cost,&selling);
    if(selling>cost)
        printf("Profit = %.2f",selling-cost);
    else if(cost>selling)
        printf("Loss = %.2f",cost-selling);
    else
        printf("No Profit No Loss");
    return 0;
}

14.Calculate Electricity Bill :
#include <stdio.h>
int main() {
    float units,bill;
    printf("Enter units: ");
    scanf("%f",&units);
    if(units<=100)
        bill=units*1.5;
    else if(units<=200)
        bill=100*1.5+(units-100)*2.5;
    else
        bill=100*1.5+100*2.5+(units-200)*4;
    printf("Electricity Bill = %.2f",bill);
    return 0;
}

15.Check Triangle Validity :
#include <stdio.h>
int main() {
    int a,b,c;
    printf("Enter three sides: ");
    scanf("%d%d%d",&a,&b,&c);
    if(a+b>c && a+c>b && b+c>a)
        printf("Valid Triangle");
    else
        printf("Invalid Triangle");
    return 0;
}

16. Find Type of Triangle:
#include <stdio.h>
int main() {
    int a,b,c;
    printf("Enter three sides: ");
    scanf("%d%d%d",&a,&b,&c);
    if(a+b<=c || a+c<=b || b+c<=a)
        printf("Invalid Triangle");
    else if(a==b && b==c)
        printf("Equilateral Triangle");
    else if(a==b || b==c || a==c)
        printf("Isosceles Triangle");
    else
        printf("Scalene Triangle");
    return 0;
}



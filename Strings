5. Reverse a String:
#include <stdio.h>
#include <string.h>
int main() {
    char str[100];
    int i;
    printf("Enter a string: ");
    scanf(" %[^\n]",str);
    printf("Reverse = ");
    for(i=strlen(str)-1;i>=0;i--)
        printf("%c",str[i]);
    return 0;
}

6. Check String Palindrome:
#include <stdio.h>
#include <string.h>
int main() {
    char str[100];
    int i,length,palindrome=1;
    printf("Enter a string: ");
    scanf(" %[^\n]",str);
    length=strlen(str);
    for(i=0;i<length/2;i++)
        if(str[i]!=str[length-i-1])
            palindrome=0;
    if(palindrome)
        printf("Palindrome");
    else
        printf("Not Palindrome");
    return 0;
}

7. Count Vowels and Consonants:
#include <stdio.h>
int main() {
    char str[100];
    int i,vowels=0,consonants=0;
    printf("Enter a string: ");
    scanf(" %[^\n]",str);
    for(i=0;str[i]!='\0';i++) {
        if(str[i]=='a'||str[i]=='e'||str[i]=='i'||str[i]=='o'||str[i]=='u'||str[i]=='A'||str[i]=='E'||str[i]=='I'||str[i]=='O'||str[i]=='U')
            vowels++;
        else if((str[i]>='a'&&str[i]<='z')||(str[i]>='A'&&str[i]<='Z'))
            consonants++;
    }
    printf("Vowels = %d\n",vowels);
    printf("Consonants = %d",consonants);
    return 0;
}

8. Count Words in a String:
#include <stdio.h>
int main() {
    char str[200];
    int i,words=1;
    printf("Enter a string: ");
    scanf(" %[^\n]",str);
    for(i=0;str[i]!='\0';i++)
        if(str[i]==' ')
            words++;
    printf("Number of Words = %d",words);
    return 0;
}

9. Count Digits and Special Characters:
#include <stdio.h>
int main() {
    char str[100];
    int i,digits=0,special=0;
    printf("Enter a string: ");
    scanf(" %[^\n]",str);
    for(i=0;str[i]!='\0';i++) {
        if(str[i]>='0'&&str[i]<='9')
            digits++;
        else if(!((str[i]>='a'&&str[i]<='z')||(str[i]>='A'&&str[i]<='Z')||str[i]==' '))
            special++;
    }
    printf("Digits = %d\n",digits);
    printf("Special Characters = %d",special);
    return 0;
}

10. Convert Lowercase to Uppercase:
#include <stdio.h>
int main() {
    char str[100];
    int i;
    printf("Enter a string: ");
    scanf(" %[^\n]",str);
    for(i=0;str[i]!='\0';i++)
        if(str[i]>='a'&&str[i]<='z')
            str[i]=str[i]-32;
    printf("Uppercase = %s",str);
    return 0;
}


6. Find Second Largest Element:
#include <stdio.h>
int main() {
    int a[100],n,i,j,temp;
    printf("Enter number of elements: ");
    scanf("%d",&n);
    printf("Enter elements: ");
    for(i=0;i<n;i++)
        scanf("%d",&a[i]);
    for(i=0;i<n-1;i++)
        for(j=i+1;j<n;j++)
            if(a[i]<a[j]) {
                temp=a[i];
                a[i]=a[j];
                a[j]=temp;
            }
    printf("Second Largest = %d",a[1]);
    return 0;
}

7. Count Even and Odd Elements:
#include <stdio.h>
int main() {
    int a[100],n,i,even=0,odd=0;
    printf("Enter number of elements: ");
    scanf("%d",&n);
    printf("Enter elements: ");
    for(i=0;i<n;i++) {
        scanf("%d",&a[i]);
        if(a[i]%2==0)
            even++;
        else
            odd++;
    }
    printf("Even = %d\n",even);
    printf("Odd = %d",odd);
    return 0;
}

8. Search an Element:
#include <stdio.h>
int main() {
    int a[100],n,i,key,found=0;
    printf("Enter number of elements: ");
    scanf("%d",&n);
    printf("Enter elements: ");
    for(i=0;i<n;i++)
        scanf("%d",&a[i]);

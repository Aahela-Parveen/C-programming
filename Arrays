14. Remove Duplicate Elements:
#include <stdio.h>
int main() {
    int a[100],n,i,j,k;
    printf("Enter number of elements: ");
    scanf("%d",&n);
    printf("Enter elements: ");
    for(i=0;i<n;i++)
        scanf("%d",&a[i]);
    for(i=0;i<n;i++)
        for(j=i+1;j<n;j++)
            if(a[i]==a[j]) {
                for(k=j;k<n-1;k++)
                    a[k]=a[k+1];
                n--;
                j--;
            }
    printf("Array without duplicates: ");
    for(i=0;i<n;i++)
        printf("%d ",a[i]);
    return 0;
}

15. Find Frequency of Elements:
#include <stdio.h>
int main() {
    int a[100],n,i,j,count;
    printf("Enter number of elements: ");
    scanf("%d",&n);
    printf("Enter elements: ");
    for(i=0;i<n;i++)
        scanf("%d",&a[i]);
    for(i=0;i<n;i++) {
        count=1;
        for(j=i+1;j<n;j++)
            if(a[i]==a[j])
                count++;
        if(i==0 || a[i]!=a[i-1])
            printf("%d = %d times\n",a[i],count);
    }
    return 0;
}

13.	Convert Celsius to Fahrenheit :
#include <stdio.h>
int main() {
    float c,f;
    printf("Enter temperature in Celsius: ");
    scanf("%f",&c);
    f=(c*9/5)+32;
    printf("Temperature in Fahrenheit = %.2f",f);
    return 0;
}

14.	Convert Days into Years, Months & Days :
#include <stdio.h>
int main() {
    int days,years,months;
    printf("Enter number of days: ");
    scanf("%d",&days);
    years=days/365;
    days=days%365;
    months=days/30;
    days=days%30;
    printf("Years = %d\n",years);
    printf("Months = %d\n",months);
    printf("Days = %d",days);
    return 0;
}


2.	Print Name, Age, College :
#include <stdio.h>
int main() {
    char name[50];
    int age;
    char college[100];
    printf("Enter name: ");
    scanf(" %[^\n]",name);
    printf("Enter age: ");
    scanf("%d",&age);
    printf("Enter college: ");
    scanf(" %[^\n]",college);
    printf("\n--- Student Details ---\n");
    printf("Name: %s\n",name);
    printf("Age: %d\n",age);
    printf("College: %s",college);
    return 0;
}


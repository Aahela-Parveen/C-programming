8. Function for GCD:
#include <stdio.h>
void gcd() {
    int a,b,i,g=1;
    printf("Enter two numbers: ");
    scanf("%d%d",&a,&b);
    for(i=1;i<=a&&i<=b;i++)
        if(a%i==0&&b%i==0)
            g=i;
    printf("GCD = %d",g);
}
int main() {
    gcd();
    return 0;
}

